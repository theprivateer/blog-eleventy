{% set canonicalUrl = page.url | absoluteUrl %}
{% set openGraphTitle = pageTitle %}
{% if contentType == 'home' %}
    {% set openGraphTitle = site.name %}
{% endif %}
{% set openGraphType = 'website' %}
{% if contentType == 'post' or contentType == 'note' %}
    {% set openGraphType = 'article' %}
{% endif %}
{% set openGraphCategory = collections.categories | categoryById(category_id) %}
<meta property="og:title" content="{{ openGraphTitle | escape }}">
<meta property="og:type" content="{{ openGraphType }}">
<meta property="og:url" content="{{ canonicalUrl }}">
<meta property="og:image" content="{{ site.openGraph.image }}">
<meta property="og:image:type" content="{{ site.openGraph.imageType }}">
<meta property="og:image:width" content="{{ site.openGraph.imageWidth }}">
<meta property="og:image:height" content="{{ site.openGraph.imageHeight }}">
<meta property="og:image:alt" content="{{ site.openGraph.imageAlt }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:locale" content="en_AU">
{% if pageDescription %}
<meta property="og:description" content="{{ pageDescription | escape }}">
{% endif %}
{% if contentType == 'post' or contentType == 'note' %}
<meta property="article:author" content="{{ site.author.url }}">
<meta property="article:published_time" content="{{ (published_at or created_at) | rfc3339Date }}">
<meta property="article:modified_time" content="{{ (updated_at or published_at or created_at) | rfc3339Date }}">
{% if openGraphCategory %}
<meta property="article:section" content="{{ openGraphCategory.data.title }}">
{% endif %}
{% endif %}
