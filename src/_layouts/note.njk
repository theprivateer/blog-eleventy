---
layout: base.njk
title: Notes
---
<h1>Notes</h1>

<article class="margin-end-4xl">
    <h3 class="margin-end-0">
        {% if link %}
        <a href="{{ link }}">{{ title }}</a>
        {% else %}
        {{ title }}
        {% endif %}
    </h3>
    <p class="text-muted">
        {{ created_at | readableDate(true) }}
        {% if link %}
        | {{ link | hostname }}
        {% endif %}
    </p>

    {{ content | safe }}
</article>
