<!DOCTYPE html>
<html lang="en-us">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="shortcut icon" href="/assets/favicon.png">

		<title>Phil Stephens | {{ (metadata.title or title or '') | escape }}</title>
		<meta name="description" content="{{ description or site.description }}">

		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/kelpui@1/css/kelp.css">
        <script
            src="https://cdn.jsdelivr.net/npm/kelpui@1/js/dark-mode-auto.js"
        ></script>
        {% if 'class="language-' in content %}
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.30.0/themes/prism-twilight.min.css">
        {% endif %}

        <link rel="alternate" type="application/atom+xml" href="/feed/posts/atom" title="Phil Stephens - all posts">
        <link rel="alternate" type="application/rss+xml" href="/feed/posts/rss" title="Phil Stephens - all posts">
        <link rel="alternate" type="application/feed+json" href="/feed/posts/json" title="Phil Stephens - all posts">
        <link rel="alternate" type="application/atom+xml" href="/feed/notes/atom" title="Phil Stephens - all notes">
        <link rel="alternate" type="application/rss+xml" href="/feed/notes/rss" title="Phil Stephens - all notes">
        <link rel="alternate" type="application/feed+json" href="/feed/notes/json" title="Phil Stephens - all notes">

        <style>
            @import url('https://fonts.googleapis.com/css2?family=Inclusive+Sans:ital,wght@0,300..700;1,300..700&display=swap');

            @layer kelp.theme {
                :root {
                    --font-size-base: 150%;
                    --font-primary: "Inclusive Sans", sans-serif;
		            --font-secondary: "Inclusive Sans", sans-serif;
                }
            }

            h1 {
                line-height: 1.2;
            }

            .logo {
                display: flex;
                align-items: center;
                gap: 0.25rem;
            }

            .logo svg {
                width: 1.5rem;
                height: auto;
            }

            .box {
                border: solid 2px var(--color-border-accent);
                border-radius: var(--border-radius-m);
            }

            article[role="blog"] img {
                max-width: 80%;
                display: block;
                margin: 0 auto;
            }
        </style>
	</head>
	<body>
        <a class="visually-hidden-focusable" href="#main-content">Skip to main content</a>

        <header class="container">
            <nav class="navbar">
                <a class="logo" href="/" aria-label="Phil Stephens homepage">
                    {% include "logo.njk" %}
                </a>
                <ul>
                    <li><a href="/blog">Blog</a></li>
                    <li><a href="/notes">Notes</a></li>
                    <li><a href="https://moments.philstephens.com">Moments</a></li>
                    <li><a href="/about">About</a></li>
                </ul>
            </nav>
        </header>
		<main id="main-content" class="container" tabindex="-1">
            {{ content | safe }}
        </main>

        <footer class="container margin-start-6xl margin-end-4xl">
            <div class="split margin-end-4xl">
                <ul class="list-unstyled">
					<li>
                        <a href="https://linkedin.com/in/phil-stephens">
                            <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M23.994 24v-.001H24v-8.802c0-4.306-.927-7.623-5.961-7.623-2.42 0-4.044 1.328-4.707 2.587h-.07V7.976H8.489v16.023h4.97v-7.934c0-2.089.396-4.109 2.983-4.109 2.549 0 2.587 2.384 2.587 4.243V24zM.396 7.977h4.976V24H.396zM2.882 0C1.291 0 0 1.291 0 2.882s1.291 2.909 2.882 2.909 2.882-1.318 2.882-2.909A2.884 2.884 0 0 0 2.882 0z"/>
                            </svg>
                            View my LinkedIn profile
                        </a>
                    </li>
					<li>
                        <a href="https://github.com/theprivateer">
                            <svg fill="currentColor" width="30" height="30" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path d="m12 .5c-6.63 0-12 5.28-12 11.792 0 5.211 3.438 9.63 8.205 11.188.6.111.82-.254.82-.567 0-.28-.01-1.022-.015-2.005-3.338.711-4.042-1.582-4.042-1.582-.546-1.361-1.335-1.725-1.335-1.725-1.087-.731.084-.716.084-.716 1.205.082 1.838 1.215 1.838 1.215 1.07 1.803 2.809 1.282 3.495.981.108-.763.417-1.282.76-1.577-2.665-.295-5.466-1.309-5.466-5.827 0-1.287.465-2.339 1.235-3.164-.135-.298-.54-1.497.105-3.121 0 0 1.005-.316 3.3 1.209.96-.262 1.98-.392 3-.398 1.02.006 2.04.136 3 .398 2.28-1.525 3.285-1.209 3.285-1.209.645 1.624.24 2.823.12 3.121.765.825 1.23 1.877 1.23 3.164 0 4.53-2.805 5.527-5.475 5.817.42.354.81 1.077.81 2.182 0 1.578-.015 2.846-.015 3.229 0 .309.21.678.825.56 4.801-1.548 8.236-5.97 8.236-11.173 0-6.512-5.373-11.792-12-11.792z" />
                            </svg>
                            Find me on GitHub
                        </a>
                    </li>

                    <li>
                        <a href="https://www.strava.com/athletes/389199">
                            <svg fill="currentColor" width="30" height="30" viewBox="0 0 24 24" role="img" xmlns="http://www.w3.org/2000/svg">
                                <path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169"/>
                            </svg>
                            Follow me on Strava
                        </a>
                    </li>
				</ul>

                <div class="split">
                    <ul class="list-unstyled">
                        <li><a href="/blog">Blog</a></li>
                        <li><a href="/notes">Notes</a></li>
                        <li><a href="https://moments.philstephens.com">Moments</a></li>
                        <li><a href="/follow">Follow</a></li>
                    </ul>

                    <ul class="list-unstyled">
                        <li><a href="/about">About</a></li>
                        <li><a href="/now">Now</a></li>
                        <li><a href="/uses">Uses</a></li>
                        <li><a href="/work">Work</a></li>
                    </ul>
                </div>
            </div>

            <div class="split">
                <p>&copy; Phil Stephens 2017-{{ build.year }}</p>
                <p><a href="/colophon">Colophon</a></p>
            </div>
        </footer>
        {% if 'class="language-' in content %}
        <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.30.0/components/prism-core.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.30.0/plugins/autoloader/prism-autoloader.min.js"></script>
        {% endif %}
	</body>
</html>
