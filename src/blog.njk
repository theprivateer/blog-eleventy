---
layout: base.njk
title: Blog
contentType: blogArchive
pageSchemaType: CollectionPage
eleventyComputed:
  description: 'Longer writing about software, engineering leadership, technology, work and the personal interests that shape how I think.{% if pagination.pageNumber > 0 %} This is page {{ pagination.pageNumber + 1 }} of the archive.{% endif %}'
pagination:
  data: collections.posts
  size: 15
  alias: posts
  reverse: false
permalink: "{% if pagination.pageNumber == 0 %}/blog/index.html{% else %}/blog/page/{{ pagination.pageNumber + 1 }}/index.html{% endif %}"
---
{% set listingPage = collections.pages | pageBySlug("blog") %}
<h1>{{ listingPage.data.title or title }}</h1>

{% if listingPage %}
    {{ listingPage.content | safe }}
{% endif %}

<section>
    {% include "post-list.njk" %}
    {% include "pagination.njk" %}
</section>
