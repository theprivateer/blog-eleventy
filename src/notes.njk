---
layout: base.njk
title: Notes
eleventyComputed:
  description: 'Short observations, links and fragments about software, the web, technology, work and anything else that catches my attention.{% if pagination.pageNumber > 0 %} This is page {{ pagination.pageNumber + 1 }} of the archive.{% endif %}'
pagination:
  data: collections.notes
  size: 15
  alias: notes
  reverse: false
permalink: "{% if pagination.pageNumber == 0 %}/notes/index.html{% else %}/notes/page/{{ pagination.pageNumber + 1 }}/index.html{% endif %}"
---
{% set listingPage = collections.pages | pageBySlug("notes") %}
<h1>{{ listingPage.data.title }}</h1>

{{ listingPage.content | safe }}

<section>
    {% for note in notes %}
        <article class="margin-end-4xl padding-m box">
            <h2 class="h3 margin-start-0 margin-end-0">
                {% if note.data.link %}
                <a href="{{ note.data.link }}">{{ note.data.title }}</a>
                {% else %}
                {{ note.data.title }}
                {% endif %}
            </h2>
            <p class="text-muted">
                {{ note.data.created_at | readableDate(true) }}
                {% if note.data.link %}
                | {{ note.data.link | hostname }}
                {% endif %}
            </p>

            {{ note.content | safe }}
        </article>
    {% endfor %}

    {% include "pagination.njk" %}
</section>
