---
pagination:
  data: collections.categories
  size: 1
  alias: category
permalink: "/category/{{ category.fileSlug }}/index.html"
layout: base.njk
eleventyComputed:
  title: "Category: {{ category.data.title }}"
---
<h1>Category: {{ category.data.title }}</h1>

{{ category.content | safe }}

<section>
    {% set posts = collections.posts | postsForCategory(category.data.id) %}
    {% for post in posts %}
        <article class="margin-end-xl">
            <h3 class="margin-end-0"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
            <p class="text-muted"><em>Posted {{ post.data.published_at | readableDate }}</em></p>
        </article>
    {% endfor %}
</section>
